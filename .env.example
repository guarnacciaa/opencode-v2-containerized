# ---------------------------------------------------------------------------
# opencode-v2 example environment.
#
#   1. Copy this file:   cp .env.example .env
#   2. Set a password below (the web UI is exposed on the network!)
#   3. Start:            docker compose up -d
#      Open:            http://localhost:4096  (or your HOST_PORT)
#
# Every variable below is optional: sane defaults apply when empty/missing.
# ---------------------------------------------------------------------------

# ---- Server authentication (the only one you SHOULD set) -------------------
# Protects the web UI login (username is always `opencode` in v2).
# Without it (and without OPENCODE_PASSWORD) the server generates a RANDOM
# password on every start: check `docker logs opencode-v2` to find it.
OPENCODE_SERVER_PASSWORD=

# ---- Server bind address / port (inside the container) --------------------
# HOSTNAME must stay 0.0.0.0 so the UI is reachable from outside the container
# (upstream default 127.0.0.1 would only listen inside it). Change it only if
# you know what you are doing.
OPENCODE_HOSTNAME=0.0.0.0
OPENCODE_PORT=4096

# ---- Host port -------------------------------------------------------------
# Port published on YOUR machine. The UI will be at http://localhost:<HOST_PORT>
HOST_PORT=4096

# ---- Project to serve ------------------------------------------------------
# Local directory mounted as /workspace inside the container (the directory
# the web UI works on). Use "." for the current directory or an absolute path.
WORKSPACE_DIR=.

# ---- Image -----------------------------------------------------------------
# Pin a version for stability (e.g. <user>/opencode-v2:2.0.29) or keep
# latest to always pull the newest v2 build.
# If you forked this repo, point it at your own image (same name you set as
# IMAGE_NAME in .github/workflows/docker-publish.yml).
IMAGE=guarnacciaa/opencode-v2:latest

# ---- Timezone (cosmetic, used in logs) -------------------------------------
TZ=Etc/UTC

# ---- AI provider keys (optional, set the ones you use) ---------------------
# You can also configure providers later from the web UI / opencode.json.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
